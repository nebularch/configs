{
    "battery#mouse": {
        "bat": "cx-mouse-battery",
        "interval": 5,
        "format": "󰍽 {capacity}%",
        "format-charging": "󰍽  {capacity}%"
    },

    "custom/myhyprv": {
        "exec": "~/.config/HyprV/hyprv_util",
        "return-type": "json",
        "format": "{text}",
        "interval": 10,
        "on-click": "~/.config/HyprV/hyprv_util vswitch",
        "tooltip": true
    },

    "custom/light_dark": {
        "format": "󰐾",
        "on-click": "~/.config/HyprV/waybar/scripts/baraction light",
        "tooltip": false
    }
}