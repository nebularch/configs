#!/bin/bash

get_pwr() {
    PWR=$(powerprofilesctl get)
}

# Get current profile
get_pwr

# Change profile when called with "next"
if [[ "$1" == "next" ]]; then
    case "$PWR" in
        balanced)
            powerprofilesctl set performance
            ;;
        performance)
            powerprofilesctl set power-saver
            ;;
        power-saver)
            powerprofilesctl set balanced
            ;;
    esac

    # Wait for power-profiles-daemon to apply the change
    sleep 0.3

    # Get the NEW profile
    get_pwr

    notify-send \
        -h string:x-canonical-private-synchronous:sys-notify \
        -u low \
        "$PWR Power Profile"
fi

# Set Waybar icon and tooltip based on the current profile
case "$PWR" in
    balanced)
        text="󰾅"
        tooltip="Balanced"
        ;;
    performance)
        text="󰓅"
        tooltip="Performance"
        ;;
    power-saver)
        text="󰾆"
        tooltip="Power Saver"
        ;;
    *)
        text="󰾆"
        tooltip="$PWR"
        ;;
esac

echo '{"text": "'$text'", "tooltip": "'$tooltip'"}'
